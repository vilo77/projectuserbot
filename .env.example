# Telegram API Credentials
API_ID=1234567
API_HASH=your_api_hash

# Bot Assistant Token
ASSISTANT_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Web Admin Password (for basic access control)
ADMIN_PASSWORD=adminpassword

# Database URL (Default uses SQLite. Railway automatically injects DATABASE_URL for Postgres)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./userbot.db
